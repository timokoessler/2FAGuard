<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.22621.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <Authors>Timo Kössler and Open Source Contributors</Authors>
    <Title>Guard.Core</Title>
    <Version>1.8.4</Version>
    <Copyright>$(Authors)</Copyright>
    <PackageProjectUrl>https://2faguard.app</PackageProjectUrl>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Restoring on Linux resolves a different set of implicit SDK packages for the Windows target, so Linux restores use their own lock file -->
    <NuGetLockFilePath Condition="!$([MSBuild]::IsOSPlatform('Windows'))">obj/packages.linux.lock.json</NuGetLockFilePath>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GuerrillaNtp" Version="3.1.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="Microsoft.Security.Extensions" Version="1.4.0" />
    <PackageReference Include="UrlBase64" Version="2.0.0" />
    <Compile Remove="**\*.Linux.cs" />
    <Compile Remove="Security\Linux\**" />
  </ItemGroup>
  <!-- Linux: Windows Hello, Win32 WebAuthn, Authenticode and the registry are replaced by Security\Linux and *.Linux.cs -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="**\*.Windows.cs" />
    <Compile Remove="Security\WindowsHello.cs" />
    <Compile Remove="Security\TrustedExecutable.cs" />
    <Compile Remove="Security\WebAuthn\**" />
    <Compile Include="Security\WebAuthn\AssertionResult.cs" />
  </ItemGroup>
</Project>
