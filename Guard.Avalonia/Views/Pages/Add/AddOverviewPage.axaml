<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
             x:Class="Guard.Avalonia.Views.Pages.Add.AddOverviewPage">
    
    <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <TextBlock Text="Add Token" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="Choose how to add a new token" FontSize="14" HorizontalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" />
        
        <StackPanel Spacing="12">
            <Button Content="Scan QR Code" Classes="accent" MinWidth="300" Click="OnScanQrClick" />
            <Button Content="Enter Key Manually" MinWidth="300" Click="OnManualClick" />
            <Button Content="Import from File" MinWidth="300" Click="OnImportClick" />
            <Button Content="Steam Guard" MinWidth="300" Click="OnSteamClick" />
        </StackPanel>
        
        <Button Content="Back" MinWidth="100" HorizontalAlignment="Center" Margin="0,20,0,0" Click="OnBackClick" />
    </StackPanel>
</UserControl>