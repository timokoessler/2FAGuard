<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="Guard.Avalonia.Views.Pages.Add.TokenSuccessPage">
    
    <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
        <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock x:Name="MessageText" FontSize="14" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
        
        <Button x:Name="DoneButton" Content="Done" Classes="accent" MinWidth="100" HorizontalAlignment="Center" Click="OnDoneClick" />
    </StackPanel>
</UserControl>