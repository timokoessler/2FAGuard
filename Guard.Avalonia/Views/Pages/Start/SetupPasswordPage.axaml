<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="Guard.Avalonia.Views.Pages.Start.SetupPasswordPage">
    
    <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
        <TextBlock Text="Set Master Password" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="Create a strong password to encrypt your vault" FontSize="14" HorizontalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" />
        
        <StackPanel Spacing="12">
            <TextBlock Text="Password" FontWeight="Medium" />
            <TextBox Name="PasswordBox" PasswordChar="●" Watermark="Enter password" />
            
            <TextBlock Text="Confirm Password" FontWeight="Medium" />
            <TextBox Name="ConfirmPasswordBox" PasswordChar="●" Watermark="Confirm password" />
            
            <TextBlock Name="ErrorText" Foreground="Red" FontSize="12" IsVisible="False" />
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Back" MinWidth="100" Click="OnBackClick" />
            <Button Content="Continue" Classes="accent" MinWidth="100" Click="OnContinueClick" />
        </StackPanel>
    </StackPanel>
</UserControl>