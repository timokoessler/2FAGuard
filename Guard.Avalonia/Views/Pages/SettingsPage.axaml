<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
             x:Class="Guard.Avalonia.Views.Pages.SettingsPage">
    
    <ScrollViewer>
        <StackPanel Spacing="20" Margin="16">
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" />
            
            <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Margin="0,0,0,16" />
            
            <StackPanel Spacing="12">
                <TextBlock Text="General" FontSize="18" FontWeight="Medium" />
                <TextBlock Text="General settings coming soon..." Foreground="Gray" />
            </StackPanel>
            
            <StackPanel Spacing="12">
                <TextBlock Text="Security" FontSize="18" FontWeight="Medium" />
                <TextBlock Text="Security settings coming soon..." Foreground="Gray" />
            </StackPanel>
            
            <StackPanel Spacing="12">
                <TextBlock Text="Appearance" FontSize="18" FontWeight="Medium" />
                <TextBlock Text="Appearance settings coming soon..." Foreground="Gray" />
            </StackPanel>
            
            <Button Content="Back to Home" Click="OnBackClick" HorizontalAlignment="Left" Margin="0,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>