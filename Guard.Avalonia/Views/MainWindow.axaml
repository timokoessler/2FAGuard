<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Guard.Avalonia.Views"
        xmlns:pages="clr-namespace:Guard.Avalonia.Views.Pages"
        xmlns:vm="clr-namespace:Guard.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="Guard.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="2FAGuard"
        Icon="/Assets/logo-256.png"
        MinWidth="400"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">
    
    <Design.DataContext>
        <views:MainWindowViewModel />
    </Design.DataContext>
    
    <Panel>
        <TransitioningContentControl Content="{Binding CurrentPage}" />
    </Panel>
</Window>