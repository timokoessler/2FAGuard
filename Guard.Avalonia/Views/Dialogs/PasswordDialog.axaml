<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
        x:Class="Guard.Avalonia.Views.Dialogs.PasswordDialog"
        Title="Enter Password"
        Width="400" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    
    <StackPanel Margin="20" Spacing="15">
        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" />
        
        <TextBox x:Name="PasswordBox" PasswordChar="●" Watermark="Password" />
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick" />
            <Button x:Name="OkButton" Content="OK" Classes="accent" Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>