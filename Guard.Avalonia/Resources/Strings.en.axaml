<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--  Nav  -->
    <sys:String x:Key="i.title">2FAGuard</sys:String>
    <sys:String x:Key="i.page.home">Tokens</sys:String>
    <sys:String x:Key="i.page.settings">Settings</sys:String>
    <sys:String x:Key="i.language">Language</sys:String>
    <sys:String x:Key="i.nav.add">Add token</sys:String>

    <!--  Settings  -->
    <sys:String x:Key="i.settings.personalisation">Personalisation</sys:String>
    <sys:String x:Key="i.settings.theme">App theme</sys:String>
    <sys:String x:Key="i.settings.theme.description">Choose a theme for the app</sys:String>
    <sys:String x:Key="i.settings.theme.system">System</sys:String>
    <sys:String x:Key="i.settings.theme.light">Light</sys:String>
    <sys:String x:Key="i.settings.theme.dark">Dark</sys:String>
    <sys:String x:Key="i.settings.language">Language</sys:String>
    <sys:String x:Key="i.settings.language.description">Select the language for the app</sys:String>
    <sys:String x:Key="i.settings.about">About this software</sys:String>
    <sys:String x:Key="i.settings.issue">Report an issue</sys:String>
    <sys:String x:Key="i.settings.security">Security</sys:String>
    <sys:String x:Key="i.settings.winhello">System Biometrics</sys:String>
    <sys:String x:Key="i.settings.winhello.description">Allow login with system biometrics (fingerprint, face, etc.)</sys:String>
    <sys:String x:Key="i.settings.winhello.failed.title">An error occurred</sys:String>
    <sys:String x:Key="i.settings.winhello.failed.content">An error occurred while setting up biometric authentication:</sys:String>
    <sys:String x:Key="i.passdialog.title">Enter your password</sys:String>
    <sys:String x:Key="i.passdialog.content">Please enter your password to confirm the action</sys:String>
    <sys:String x:Key="i.passdialog.input">Your password</sys:String>
    <sys:String x:Key="i.passdialog.next">Next</sys:String>
    <sys:String x:Key="i.passdialog.incorrect">The password is incorrect</sys:String>
    <sys:String x:Key="i.settings.password">Password</sys:String>
    <sys:String x:Key="i.settings.password.description">Change your password</sys:String>
    <sys:String x:Key="i.settings.password.button">Change</sys:String>
    <sys:String x:Key="i.changepass.title">Change password</sys:String>
    <sys:String x:Key="i.changepass.currentbox">Current password</sys:String>
    <sys:String x:Key="i.changepass.newbox">Enter a new password</sys:String>
    <sys:String x:Key="i.changepass.newbox.repeat">Repeat the new password</sys:String>
    <sys:String x:Key="i.changepass.current.notempty">Please enter your current password</sys:String>
    <sys:String x:Key="i.changepass.current.incorrect">The current password you entered is incorrect</sys:String>
    <sys:String x:Key="i.settings.record">Prevent recording</sys:String>
    <sys:String x:Key="i.settings.record.description">Blocks screen recording and screenshots of the app</sys:String>
    <sys:String x:Key="i.settings.autolock">Auto lock on system lock</sys:String>
    <sys:String x:Key="i.settings.autolock.description">Lock the app if the system is locked</sys:String>
    <sys:String x:Key="i.settings.oss">Used open source software</sys:String>
    <sys:String x:Key="i.settings.autostart">Autostart</sys:String>
    <sys:String x:Key="i.settings.autostart.description">Automatically open the app when system starts</sys:String>
    <sys:String x:Key="i.settings.autostart.error.title">An error has occurred</sys:String>
    <sys:String x:Key="i.settings.autostart.error.disabled.policy">The automatic start of the app has been deactivated by a system policy</sys:String>
    <sys:String x:Key="i.settings.autostart.error.disabled.user">The automatic start of the app has been deactivated and can only be changed in system settings</sys:String>
    <sys:String x:Key="i.settings.autostart.error.alreadyenabled">The automatic start of the app is already activated</sys:String>
    <sys:String x:Key="i.settings.autostart.error.notenabled">The automatic start of the app cannot be deactivated as it is already deactivated</sys:String>
    <sys:String x:Key="i.settings.tray">Minimize and close to tray</sys:String>
    <sys:String x:Key="i.settings.tray.description">Move the app to the system tray when minimizing and closing</sys:String>
    <sys:String x:Key="i.settings.imprint">Imprint</sys:String>
    <sys:String x:Key="i.settings.privacy">Privacy</sys:String>
    <sys:String x:Key="i.settings.reset">Reset app</sys:String>
    <sys:String x:Key="i.settings.reset.description">Delete all tokens and settings</sys:String>
    <sys:String x:Key="i.settings.reset.button">Reset</sys:String>
    <sys:String x:Key="i.settings.reset.confirm.title">Are you sure?</sys:String>
    <sys:String x:Key="i.settings.reset.confirm.content">Do you really want to delete all tokens and settings? This action cannot be undone.</sys:String>
    <sys:String x:Key="i.settings.reset.confirm.btn">Reset</sys:String>
    <sys:String x:Key="i.settings.locktime">Lock timer</sys:String>
    <sys:String x:Key="i.settings.locktime.description">Lock the app after a certain time of inactivity</sys:String>
    <sys:String x:Key="i.settings.locktime.never">Never</sys:String>
    <sys:String x:Key="i.settings.locktime.thirtyseconds">30 seconds</sys:String>
    <sys:String x:Key="i.settings.locktime.oneminute">1 minute</sys:String>
    <sys:String x:Key="i.settings.locktime.fiveminutes">5 minutes</sys:String>
    <sys:String x:Key="i.settings.locktime.tenminutes">10 minutes</sys:String>
    <sys:String x:Key="i.settings.locktime.thirtyminutes">30 minutes</sys:String>
    <sys:String x:Key="i.settings.locktime.onehour">1 hour</sys:String>
    <sys:String x:Key="i.page.changepasswordpage">Change password</sys:String>
    <sys:String x:Key="i.settings.webauthn">Security Key (FIDO2)</sys:String>
    <sys:String x:Key="i.settings.webauthn.description">Login with a hardware security key</sys:String>
    <sys:String x:Key="i.settings.webauthn.button">Configure</sys:String>
    <sys:String x:Key="i.settings.webauthn.notsupported">Your operating system does not seem to support WebAuthn.</sys:String>
    <sys:String x:Key="i.settings.restorewindow">Remember window position</sys:String>
    <sys:String x:Key="i.settings.restorewindow.description">Open the app in the same position as it was closed</sys:String>
    <sys:String x:Key="i.settings.hidetoken">Hide the generated tokens</sys:String>
    <sys:String x:Key="i.settings.hidetoken.description">Do not display the tokens on the screen</sys:String>
    <sys:String x:Key="i.settings.hidetoken.never">Never hide</sys:String>
    <sys:String x:Key="i.settings.hidetoken.showafterclick">Show after click</sys:String>
    <sys:String x:Key="i.settings.hidetoken.always">Always hide</sys:String>
    <sys:String x:Key="i.settings.clearclipboard">Clear clipboard</sys:String>
    <sys:String x:Key="i.settings.clearclipboard.description">Clear the clipboard after copying a token</sys:String>
    <sys:String x:Key="i.settings.clearclipboard.disabled">Never</sys:String>
    <sys:String x:Key="i.settings.clearclipboard.tenseconds">10 seconds</sys:String>
    <sys:String x:Key="i.settings.clearclipboard.twentyseconds">20 seconds</sys:String>
    <sys:String x:Key="i.settings.clearclipboard.thirtyseconds">30 seconds</sys:String>
    <sys:String x:Key="i.settings.clearclipboard.oneminute">1 minute</sys:String>

    <!--  WebAuthn  -->
    <sys:String x:Key="i.page.webauthnpage">Security Key (FIDO2)</sys:String>
    <sys:String x:Key="i.webauthn.add.title">Add Security Key</sys:String>
    <sys:String x:Key="i.webauthn.add.description">Register a new key</sys:String>
    <sys:String x:Key="i.webauthn.existing">Existing keys</sys:String>
    <sys:String x:Key="i.webauthn.existing.none">No keys available</sys:String>
    <sys:String x:Key="i.webauthn.dialog1.title">Add Security Key</sys:String>
    <sys:String x:Key="i.webauthn.dialog1.content">Please enter a name for the security key you want to add</sys:String>
    <sys:String x:Key="i.webauthn.dialog1.input">A name to identify the key</sys:String>
    <sys:String x:Key="i.webauthn.dialog1.content2">Please note that after the system pop-up says that you can now log in with the security key, you have to complete the directly following authentication step to finish the registration.</sys:String>
    <sys:String x:Key="i.webauthn.dialog1.namerequired">You have to enter a name for the security key</sys:String>
    <sys:String x:Key="i.webauthn.dialog.nameexists">A security key with this name already exists</sys:String>
    <sys:String x:Key="i.webauthn.delete.title">Remove Security Key</sys:String>
    <sys:String x:Key="i.webauthn.delete.content">Are you sure you want to remove the security key @Name? You can not use this key for authentication anymore.</sys:String>
    <sys:String x:Key="i.webauthn.delete.yes">Remove</sys:String>

    <!--  Application setup  -->
    <sys:String x:Key="i.welcome.subtext">Thanks for downloading! Please choose how you would like to secure your tokens.</sys:String>
    <sys:String x:Key="i.welcome.hello">System Biometrics or Password</sys:String>
    <sys:String x:Key="i.welcome.hello.description">Simple and secure, Password as a fallback</sys:String>
    <sys:String x:Key="i.welcome.hello.notavailable">System biometrics not available</sys:String>
    <sys:String x:Key="i.welcome.hello.notavailable.content">Please configure biometric authentication in your system settings to be able to use this function.</sys:String>
    <sys:String x:Key="i.welcome.pass">Only Password</sys:String>
    <sys:String x:Key="i.welcome.pass.description">Secure your tokens with a password</sys:String>
    <sys:String x:Key="i.welcome.skip">Skip</sys:String>
    <sys:String x:Key="i.welcome.pass.title">Set a password</sys:String>
    <sys:String x:Key="i.welcome.pass.subtext">Please enter a secure password that will be used to encrypt your tokens. If you forget this password, you will not be able to access your tokens anymore.</sys:String>
    <sys:String x:Key="i.welcome.pass.box">Enter a secure password</sys:String>
    <sys:String x:Key="i.welcome.pass.box.repeat">Repeat the password</sys:String>
    <sys:String x:Key="i.welcome.pass.notempty">The password cannot be empty</sys:String>
    <sys:String x:Key="i.welcome.pass.notmatch">The passwords do not match</sys:String>
    <sys:String x:Key="i.welcome.pass.length">The password must be at least 8 and at most 128 characters long</sys:String>
    <sys:String x:Key="i.setup.finished.title">Setup finished</sys:String>
    <sys:String x:Key="i.setup.finished.subtext">You have successfully set up 2FAGuard. You can now start adding your tokens.</sys:String>
    <sys:String x:Key="i.setup.finished.action.token">Add a token</sys:String>
    <sys:String x:Key="i.setup.finished.action.token.description">Add the first token to your collection</sys:String>
    <sys:String x:Key="i.setup.finished.action.settings">Settings</sys:String>
    <sys:String x:Key="i.setup.finished.action.settings.description">Change the application settings</sys:String>
    <sys:String x:Key="i.welcome.insecure.dialog.title">Are you sure?</sys:String>
    <sys:String x:Key="i.welcome.insecure.dialog.content">You have chosen to use 2FAGuard without any security. This means that your tokens are not encrypted and can be accessed by anyone who has access to your computer. Are you sure you want to continue?</sys:String>
    <sys:String x:Key="i.welcome.insecure.dialog.continue">Continue (not recommended)</sys:String>
    <sys:String x:Key="i.welcome.portable.winhello.title">Note</sys:String>
    <sys:String x:Key="i.welcome.portable.winhello.content">If you are using the portable version of 2FAGuard on a USB stick or other portable storage device, you cannot automatically log in with system biometrics with other users or on other devices. You must first activate biometrics on other devices in the 2FAGuard settings. You can always log in with your password.</sys:String>
    <sys:String x:Key="i.page.welcome">Welcome</sys:String>

    <!--  Login  -->
    <sys:String x:Key="i.login.subtext">Please prove your identity to access your tokens</sys:String>
    <sys:String x:Key="i.login.passbox">Enter your password</sys:String>
    <sys:String x:Key="i.login.button">Login with Password</sys:String>
    <sys:String x:Key="i.login.pass.error">The password is incorrect</sys:String>
    <sys:String x:Key="i.login.winhellobutton">System Biometrics</sys:String>
    <sys:String x:Key="i.login.warning.capslock.title">Warning</sys:String>
    <sys:String x:Key="i.login.warning.capslock.content">Caps Lock is activated</sys:String>
    <sys:String x:Key="i.login.webauthn">Security Key</sys:String>

    <!--  Home  -->
    <sys:String x:Key="i.home.loading">Loading...</sys:String>
    <sys:String x:Key="i.home.notokens">No tokens found</sys:String>
    <sys:String x:Key="i.home.notokens.button">Add token</sys:String>
    <sys:String x:Key="i.home.search.placeholder">Search tokens</sys:String>
    <sys:String x:Key="i.home.intro.title">Notice</sys:String>
    <sys:String x:Key="i.home.intro.content">You can perform further actions, such as editing or deleting, by right-clicking on a token.</sys:String>

    <!--  Add  -->
    <sys:String x:Key="i.page.addoverview">Add tokens</sys:String>
    <sys:String x:Key="i.add.manual">Manual input</sys:String>
    <sys:String x:Key="i.add.manual.description">Enter the secret key and further information</sys:String>
    <sys:String x:Key="i.add.qr">Import QR code</sys:String>
    <sys:String x:Key="i.add.qr.description">Scan a QR code by importing an image file</sys:String>
    <sys:String x:Key="i.add.qrscreen">Scan QR code from the screen</sys:String>
    <sys:String x:Key="i.add.qrscreen.description">Detects a visible QR code on the screen</sys:String>
    <sys:String x:Key="i.add.clipboard">Add from clipboard</sys:String>
    <sys:String x:Key="i.add.clipboard.description">Paste a QR code image or a TOTP URI</sys:String>
    <sys:String x:Key="i.add.import">Import</sys:String>
    <sys:String x:Key="i.import.backup">Backup</sys:String>
    <sys:String x:Key="i.import.backup.description">Import a backup file that was created with 2FAGuard</sys:String>
    <sys:String x:Key="i.import.uri">URI list</sys:String>
    <sys:String x:Key="i.import.uri.description">Import a list of TOTP URIs</sys:String>
    <sys:String x:Key="i.import.bitwarden">Bitwarden</sys:String>
    <sys:String x:Key="i.import.bitwarden.description">Import tokens from the password manager Bitwarden</sys:String>
    <sys:String x:Key="i.import.bitwarden.accountencryption">The selected backup is limited to your Bitwarden account and cannot be imported by other applications. Please create a password-protected backup to import it into 2FAGuard.</sys:String>
    <sys:String x:Key="i.import.failed.title">Import failed</sys:String>
    <sys:String x:Key="i.import.failed.content">An error occurred while importing:</sys:String>
    <sys:String x:Key="i.import.noqrfound">Could not detect a QR code</sys:String>
    <sys:String x:Key="i.import.noqrfound.screen">No QR code was detected. Please make sure that no window is covering the QR code and that the QR code is clearly visible.</sys:String>
    <sys:String x:Key="i.import.invalidqr.screen">The QR code does not contain valid information about a token. Please also make sure that only one QR code is visible on the screen.</sys:String>
    <sys:String x:Key="i.import.clipboard.invalid">The clipboard does not contain an image or text.</sys:String>
    <sys:String x:Key="i.import.clipboard.invalid.multifiles">Currently only one file can be imported from the clipboard at a time.</sys:String>
    <sys:String x:Key="i.import.duplicate">A token with the same secret key already exists</sys:String>
    <sys:String x:Key="i.home.sort">Sort order</sys:String>
    <sys:String x:Key="i.home.sort.issuer.asc">Issuer, ascending</sys:String>
    <sys:String x:Key="i.home.sort.issuer.desc">Issuer, descending</sys:String>
    <sys:String x:Key="i.home.sort.createdat.asc">Creation date, ascending</sys:String>
    <sys:String x:Key="i.home.sort.createdat.desc">Creation date, descending</sys:String>
    <sys:String x:Key="i.import.notokens">No tokens found in the import file</sys:String>
    <sys:String x:Key="i.import.authpro">Stratum</sys:String>
    <sys:String x:Key="i.import.authpro.description">Import a backup file from the app Stratum</sys:String>
    <sys:String x:Key="i.import.gauthenticator">Google Authenticator</sys:String>
    <sys:String x:Key="i.import.gauthenticator.description">Import tokens from the Google Authenticator app</sys:String>
    <sys:String x:Key="i.import.gauthenticator.msgbox.content">To import tokens from Google Authenticator, open the app on your smartphone or tablet and select "Transfer accounts" in the menu and then "Export accounts".@nThen take a screenshot of the displayed QR code and copy the image file to this device.@nImport this file by selecting "Import QR code" at the top of this application.@n@nNote: A QR code can only store a limited amount of information. Please select a maximum of 5 tokens at the same time in the Google Authenticator app for export.</sys:String>
    <sys:String x:Key="i.import.authpro.invalid">The selected file is not a valid backup of the Stratum app.</sys:String>
    <sys:String x:Key="i.import.authpro.legacy">The selected backup is in an outdated format and cannot be imported. Please create the backup with a current version of the Stratum app.</sys:String>
    <sys:String x:Key="i.import.password">Please enter the password for the backup file</sys:String>
    <sys:String x:Key="i.import.password.invalid">The entered password is incorrect</sys:String>
    <sys:String x:Key="i.import.hotp.notsupported">Counter-based tokens (HOTP) are not supported</sys:String>
    <sys:String x:Key="i.import.twofas">2FAS</sys:String>
    <sys:String x:Key="i.import.twofas.description">Import a backup file from the app 2FAS</sys:String>
    <sys:String x:Key="i.import.aegis">Aegis Authenticator</sys:String>
    <sys:String x:Key="i.import.aegis.description">Import an Aegis Authenticator export</sys:String>
    <sys:String x:Key="i.import.protonauthenticator">Proton Authenticator</sys:String>
    <sys:String x:Key="i.import.protonauthenticator.description">Import tokens from the Proton Authenticator app</sys:String>
    <sys:String x:Key="i.page.tokensettings">Token</sys:String>
    <sys:String x:Key="i.page.tokensettings.add">Add token</sys:String>
    <sys:String x:Key="i.page.tokensettings.edit">Edit token</sys:String>

    <!--  Export  -->
    <sys:String x:Key="i.page.exportpage">Export tokens</sys:String>
    <sys:String x:Key="i.export.failed.title">Export failed</sys:String>
    <sys:String x:Key="i.export.failed.content">An error occurred while exporting:</sys:String>
    <sys:String x:Key="i.export.failed.unencrypted">Unencrypted backups are blocked by your administrator</sys:String>
    <sys:String x:Key="i.export.password">Please enter a password for the backup file</sys:String>
    <sys:String x:Key="i.export.password.invalid">Please enter a valid password</sys:String>
    <sys:String x:Key="i.export.backup">Backup</sys:String>
    <sys:String x:Key="i.export.backup.description">Complete backup file, only compatible with 2FAGuard</sys:String>
    <sys:String x:Key="i.export.uri">URI list</sys:String>
    <sys:String x:Key="i.export.uri.description">Export a list of TOTP URIs without notes and unencrypted</sys:String>
    <sys:String x:Key="i.export.success.title">Tokens exported</sys:String>
    <sys:String x:Key="i.export.success.content">Your tokens have been exported successfully.</sys:String>
    <sys:String x:Key="i.export.success.open">Open folder</sys:String>
    <sys:String x:Key="i.export.notokens">There are no tokens that can be exported</sys:String>
    <sys:String x:Key="i.export.authpro">Stratum</sys:String>
    <sys:String x:Key="i.export.authpro.description">Export tokens as a Stratum backup file</sys:String>

    <!--  Token Details  -->
    <sys:String x:Key="i.td.general">General information</sys:String>
    <sys:String x:Key="i.td.issuer">Name of the issuer</sys:String>
    <sys:String x:Key="i.td.issuer.placeholder">For example: Google or Apple</sys:String>
    <sys:String x:Key="i.td.username">Username</sys:String>
    <sys:String x:Key="i.td.username.placeholder">Usually your email address</sys:String>
    <sys:String x:Key="i.td.secret">Secret key</sys:String>
    <sys:String x:Key="i.td.secret.placeholder">Paste or enter the secret key</sys:String>
    <sys:String x:Key="i.td.expert">Expert settings</sys:String>
    <sys:String x:Key="i.td.expert.warning.title">Warning</sys:String>
    <sys:String x:Key="i.td.expert.warning.text">Only change these settings if you know what you are doing</sys:String>
    <sys:String x:Key="i.td.expert.warning.button">Continue anyway</sys:String>
    <sys:String x:Key="i.td.expert.algorithm">Algorithm</sys:String>
    <sys:String x:Key="i.td.expert.digits">Digits</sys:String>
    <sys:String x:Key="i.td.expert.digits.placeholder">6 is the standard</sys:String>
    <sys:String x:Key="i.td.expert.period">Validity in seconds</sys:String>
    <sys:String x:Key="i.td.expert.period.placeholder">30s is the standard</sys:String>
    <sys:String x:Key="i.td.icon.text">Enter a issuer name to get a matching icon</sys:String>
    <sys:String x:Key="i.td.note">Note (optional)</sys:String>
    <sys:String x:Key="i.td.format">Format</sys:String>
    <sys:String x:Key="i.td.noissuer">Please enter the name of the issuer</sys:String>
    <sys:String x:Key="i.td.nosecret">Please enter the secret key</sys:String>
    <sys:String x:Key="i.td.invalidsecret">The secret key is invalid</sys:String>
    <sys:String x:Key="i.td.invaliddigits">The number of digits is invalid</sys:String>
    <sys:String x:Key="i.td.invalidperiod">The validity period is invalid</sys:String>
    <sys:String x:Key="i.settings.license">License</sys:String>
    <sys:String x:Key="i.td.customicon.btn">Custom icon</sys:String>
    <sys:String x:Key="i.td.customicon.dialog.title">Select an icon</sys:String>
    <sys:String x:Key="i.td.customicon.tolarge">Only images with a maximum size of 1MB are supported</sys:String>

    <!--  Token Success Page  -->
    <sys:String x:Key="i.page.tokensuccesspage">Token</sys:String>
    <sys:String x:Key="i.stp.added">Token added</sys:String>
    <sys:String x:Key="i.stp.home">View all tokens</sys:String>
    <sys:String x:Key="i.stp.edited">Token edited</sys:String>
    <sys:String x:Key="i.stp.added.multiple">Added tokens</sys:String>
    <sys:String x:Key="i.stp.added.multiple.description">@Count tokens have been added successfully</sys:String>
    <sys:String x:Key="i.stp.added.multiple.duplicate">@Count tokens were not added because they already exist</sys:String>

    <!--  Text Formatting Dialog  -->
    <sys:String x:Key="i.txtfd.title">Format text</sys:String>
    <sys:String x:Key="i.txtfd.content">Ctrl+B: Bold@nCtrl+I: Italic@nCtrl+U: Underline@nCtrl+Shift+L: Bullet points@nCtrl+Shift+N: Numbering@nCtrl+E: Center text@nCtrl+L: Text left@nCtrl+R: Text right</sys:String>

    <!--  Token card  -->
    <sys:String x:Key="i.tokencard.copy">Copy</sys:String>
    <sys:String x:Key="i.tokencard.edit">Edit</sys:String>
    <sys:String x:Key="i.tokencard.delete">Delete</sys:String>
    <sys:String x:Key="i.tokencard.delete.modal.title">Delete token</sys:String>
    <sys:String x:Key="i.tokencard.delete.modal.content">Are you sure you want to delete the token @Name? This action cannot be undone.</sys:String>
    <sys:String x:Key="i.tokencard.delete.modal.yes">Delete</sys:String>
    <sys:String x:Key="i.tokencard.qr">Display QR code</sys:String>
    <sys:String x:Key="i.tokencard.save">Save</sys:String>
    <sys:String x:Key="i.tokencard.qr.keepsecure">This QR code contains sensitive information. Keep it secure.</sys:String>

    <!--  Update  -->
    <sys:String x:Key="i.update.title">Update available</sys:String>
    <sys:String x:Key="i.update.content">A new version of 2FAGuard is available. Do you want to install it now?</sys:String>
    <sys:String x:Key="i.update.install">Install update</sys:String>
    <sys:String x:Key="i.update.skip">Skip</sys:String>
    <sys:String x:Key="i.update.loading">Downloading update...</sys:String>
    <sys:String x:Key="i.update.error.title">Update failed</sys:String>
    <sys:String x:Key="i.update.error.content">An error occurred while updating</sys:String>
    <sys:String x:Key="i.update.changelog">View changelog</sys:String>

    <!--  Tray  -->
    <sys:String x:Key="i.tray.exit">Exit</sys:String>
    <sys:String x:Key="i.tray.lock">Lock</sys:String>


    <!--  Password  -->
    <sys:String x:Key="i.pass.invalid.minlength">The password must be at least @Length characters long</sys:String>
    <sys:String x:Key="i.pass.invalid.maxlength">The password must not be longer than 128 characters</sys:String>
    <sys:String x:Key="i.pass.invalid.case">The password must contain at least one lowercase and one uppercase letter</sys:String>
    <sys:String x:Key="i.pass.invalid.digit">The password must contain at least one digit</sys:String>
    <sys:String x:Key="i.pass.invalid.special">The password must contain at least one special character</sys:String>

    <!--  Other  -->
    <sys:String x:Key="i.win.hello.request">The application 2FAGuard wants to prove your identity</sys:String>
    <sys:String x:Key="i.error">Error</sys:String>
    <sys:String x:Key="i.save">Save</sys:String>
    <sys:String x:Key="i.dialog.close">Close</sys:String>
    <sys:String x:Key="i.dialog.next">Next</sys:String>
    <sys:String x:Key="i.dialog.cancel">Cancel</sys:String>
    <sys:String x:Key="i.error.unhandled.title">Unhandled exception</sys:String>
    <sys:String x:Key="i.error.unhandled.content">An unexpected error has occurred. Please report this error so that it can be corrected. You can find more information in the log file.</sys:String>
    <sys:String x:Key="i.error.unhandled.openbug">Report bug</sys:String>
    <sys:String x:Key="i.error.time.title">Warning: System time not synchronized</sys:String>
    <sys:String x:Key="i.error.time.content">The time on your system deviates from the correct time by more than 10 seconds. This can lead to problems with the generation of TOTP codes. Please make sure that the time on your system is correct.</sys:String>
    <sys:String x:Key="i.running.title">App is already running</sys:String>
    <sys:String x:Key="i.running.content">This app can only be executed once at a time.</sys:String>
    <sys:String x:Key="i.running.exit">Exit</sys:String>
    <sys:String x:Key="i.error.unhandled.github">Thank you for your report! If you like, feel free to create an issue on GitHub to be informed about the progress.</sys:String>
    <sys:String x:Key="i.error.unhandled.github.open">Create Issue</sys:String>
    <sys:String x:Key="i.unsupported.os.title">OS not supported</sys:String>
    <sys:String x:Key="i.unsupported.os.content">Please update to a supported OS version to use 2FAGuard.</sys:String>
    <sys:String x:Key="i.unsupported.exit">Exit</sys:String>
    <sys:String x:Key="i.unsupported.arch.title">Architecture not supported</sys:String>
    <sys:String x:Key="i.unsupported.arch.content">The architecture of your system is not supported. 2FAGuard only supports 64-bit systems.</sys:String>
    <sys:String x:Key="i.unsupported.vcpp.title">Required dependencies not installed</sys:String>
    <sys:String x:Key="i.unsupported.vcpp.content">Required system dependencies are missing. Please install them to use 2FAGuard.</sys:String>
    <sys:String x:Key="i.unsupported.vcpp.download">Download</sys:String>
    <sys:String x:Key="i.unsupported.olderversion.title">Outdated app version</sys:String>
    <sys:String x:Key="i.unsupported.olderversion.content">You are using an outdated version of 2FAGuard. Data that has already been edited with a newer version of the app cannot be opened. Please update the app to use the data.</sys:String>
</ResourceDictionary>