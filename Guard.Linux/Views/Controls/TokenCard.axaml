<UserControl
    x:Class="Guard.Linux.Views.Controls.TokenCard"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="using:Avalonia.Svg.Skia"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    Width="360"
    Height="120"
    Margin="5"
    Cursor="Hand"
    Focusable="True">
    <UserControl.Styles>
        <Style Selector="Border#Card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style Selector="Border#Card:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
        <Style Selector="UserControl:focus-visible Border#Card">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>
    <Border
        x:Name="Card"
        BorderThickness="1"
        CornerRadius="10">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Click="MenuItem_Copy_Click" Header="{DynamicResource i.tokencard.copy}" />
                <MenuItem Click="MenuItem_Edit_Click" Header="{DynamicResource i.tokencard.edit}" />
                <MenuItem Click="MenuItem_Qr_Click" Header="{DynamicResource i.tokencard.qr}" />
                <MenuItem Click="MenuItem_Delete_Click" Header="{DynamicResource i.tokencard.delete}" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Panel
                Grid.Column="0"
                Width="45"
                Height="45"
                Margin="22,0,0,0"
                VerticalAlignment="Center">
                <svg:Svg x:Name="SvgIconView" />
                <Image x:Name="ImageIconView" IsVisible="False" />
            </Panel>
            <StackPanel
                Grid.Column="1"
                Margin="24,0,0,0"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="Issuer"
                    FontSize="18"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="Username"
                    Classes="secondary"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <TextBlock
                    x:Name="TokenTextBlock"
                    FontSize="32"
                    FontWeight="Bold"
                    Text="??? ???" />
            </StackPanel>
            <Panel
                Grid.Column="2"
                Width="60"
                Height="60"
                Margin="12,0,22,0"
                VerticalAlignment="Center">
                <ui:ProgressRing
                    x:Name="TimeProgressRing"
                    Width="52"
                    Height="52"
                    IsIndeterminate="False"
                    Maximum="100"
                    Minimum="0"
                    Value="0">
                    <ui:ProgressRing.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Value" Duration="0:0:1" />
                        </Transitions>
                    </ui:ProgressRing.Transitions>
                </ui:ProgressRing>
                <svg:Svg
                    x:Name="SvgIconRingView"
                    IsVisible="False"
                    Path="/Assets/check.svg" />
            </Panel>
        </Grid>
    </Border>
</UserControl>
