<UserControl
    x:Class="Guard.Linux.Views.Pages.Start.Welcome"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="using:Avalonia.Svg.Skia"
    xmlns:ui="using:FluentAvalonia.UI.Controls">
    <StackPanel HorizontalAlignment="Center">
        <svg:Svg
            x:Name="HeaderLogo"
            Width="200"
            Height="200"
            Margin="0,45,0,0"
            Path="/Assets/logo.svg" />
        <TextBlock
            x:Name="HeaderTitle"
            Margin="0,20,0,0"
            Classes="headerTitle"
            Text="{DynamicResource i.title}" />
        <TextBlock
            x:Name="HeaderSubtitle"
            Margin="0,20,0,30"
            Classes="headerSubtitle"
            Text="{DynamicResource i.welcome.subtext}" />
        <ui:SettingsExpander
            x:Name="WinHelloBtn"
            Classes="setupCard"
            Click="CardAction_WinHello_Click"
            Description="{DynamicResource i.welcome.hello.description}"
            Header="{DynamicResource i.welcome.hello}">
            <ui:SettingsExpander.IconSource>
                <ui:PathIconSource Data="{StaticResource Icon.Fingerprint}" />
            </ui:SettingsExpander.IconSource>
        </ui:SettingsExpander>
        <ui:SettingsExpander
            x:Name="PasswordBtn"
            Classes="setupCard"
            Click="CardAction_Password_Click"
            Description="{DynamicResource i.welcome.pass.description}"
            Header="{DynamicResource i.welcome.pass}">
            <ui:SettingsExpander.IconSource>
                <ui:PathIconSource Data="{StaticResource Icon.Password}" />
            </ui:SettingsExpander.IconSource>
        </ui:SettingsExpander>
        <Button
            x:Name="SkipBtn"
            Margin="0,20,0,0"
            HorizontalAlignment="Center"
            Click="Button_Skip_Click"
            Content="{DynamicResource i.welcome.skip}" />
    </StackPanel>
</UserControl>
