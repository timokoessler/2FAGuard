<UserControl
    x:Class="Guard.Linux.Views.Pages.Start.Login"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="using:Avalonia.Svg.Skia"
    xmlns:ui="using:FluentAvalonia.UI.Controls">
    <StackPanel HorizontalAlignment="Center">
        <svg:Svg
            x:Name="HeaderLogo"
            Width="200"
            Height="200"
            Margin="0,45,0,0"
            Path="/Assets/logo.svg" />
        <TextBlock
            x:Name="HeaderTitle"
            Margin="0,20,0,0"
            Classes="headerTitle"
            Text="{DynamicResource i.title}" />
        <TextBlock
            x:Name="HeaderSubtitle"
            Margin="0,20,0,30"
            Classes="headerSubtitle"
            Text="{DynamicResource i.login.subtext}" />
        <TextBox
            x:Name="PasswordBox"
            Width="320"
            Classes="revealPasswordButton"
            PasswordChar="●"
            Watermark="{DynamicResource i.login.passbox}" />
        <Button
            x:Name="LoginButton"
            Margin="0,22,0,0"
            HorizontalAlignment="Center"
            Classes="accent"
            Click="LoginButton_Click"
            IsDefault="True">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon
                    Width="16"
                    Height="16"
                    Data="{StaticResource Icon.ArrowCircleRight}" />
                <TextBlock Text="{DynamicResource i.login.button}" />
            </StackPanel>
        </Button>
        <Button
            x:Name="KeyringButton"
            Margin="0,15,0,0"
            HorizontalAlignment="Center"
            Click="KeyringButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon
                    Width="16"
                    Height="16"
                    Data="{StaticResource Icon.Fingerprint}" />
                <TextBlock Text="{DynamicResource i.login.winhellobutton}" />
            </StackPanel>
        </Button>
        <Button
            x:Name="WebAuthnBtn"
            Margin="0,15,0,0"
            HorizontalAlignment="Center"
            Click="WebAuthnBtn_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon
                    Width="16"
                    Height="16"
                    Data="{StaticResource Icon.UsbStick}" />
                <TextBlock Text="{DynamicResource i.login.webauthn}" />
            </StackPanel>
        </Button>
        <ui:InfoBar
            x:Name="InfoBar"
            MaxWidth="400"
            Margin="0,20,0,0"
            IsOpen="False" />
        <ProgressBar
            x:Name="LoginProgressBar"
            Width="320"
            Margin="0,5,0,0"
            IsIndeterminate="True"
            IsVisible="False" />
    </StackPanel>
</UserControl>
