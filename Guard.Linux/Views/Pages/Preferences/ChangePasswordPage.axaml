<UserControl
    x:Class="Guard.Linux.Views.Pages.Preferences.ChangePasswordPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svg="using:Avalonia.Svg.Skia"
    xmlns:ui="using:FluentAvalonia.UI.Controls">
    <StackPanel HorizontalAlignment="Center">
        <svg:Svg
            Width="100"
            Height="100"
            Margin="0,45,0,0"
            Path="/Assets/padlock-gradient.svg" />
        <TextBlock
            Margin="0,20,0,0"
            Classes="headerTitle"
            Text="{DynamicResource i.changepass.title}" />
        <TextBlock
            Margin="0,20,0,30"
            Classes="headerSubtitle"
            Text="{DynamicResource i.welcome.pass.subtext}" />
        <TextBox
            x:Name="CurrentPass"
            Width="300"
            Classes="revealPasswordButton"
            PasswordChar="●"
            Watermark="{DynamicResource i.changepass.currentbox}" />
        <TextBox
            x:Name="PasswordBox"
            Width="300"
            Margin="0,15,0,0"
            Classes="revealPasswordButton"
            PasswordChar="●"
            Watermark="{DynamicResource i.changepass.newbox}" />
        <TextBox
            x:Name="PasswordBoxRepeat"
            Width="300"
            Margin="0,15,0,0"
            Classes="revealPasswordButton"
            PasswordChar="●"
            Watermark="{DynamicResource i.changepass.newbox.repeat}" />
        <Button
            x:Name="SaveButton"
            Margin="0,20,0,0"
            HorizontalAlignment="Center"
            Classes="accent"
            Click="Button_Click"
            IsDefault="True">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon
                    Width="16"
                    Height="16"
                    Data="{StaticResource Icon.ArrowCircleRight}" />
                <TextBlock Text="{DynamicResource i.save}" />
            </StackPanel>
        </Button>
        <ui:InfoBar
            x:Name="InfoBar"
            MaxWidth="400"
            Margin="0,20,0,0"
            IsOpen="False" />
        <ProgressBar
            x:Name="RegisterProgressBar"
            Width="300"
            Margin="0,5,0,0"
            IsIndeterminate="True"
            IsVisible="False" />
    </StackPanel>
</UserControl>
