<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Title>2FAGuard</Title>
    <Version>1.8.4</Version>
    <Authors>Timo Kössler and Open Source Contributors</Authors>
    <Copyright>$(Authors)</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/timokoessler/2FAGuard</RepositoryUrl>
    <PackageProjectUrl>https://2faguard.app</PackageProjectUrl>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <AssemblyName>2fa-guard</AssemblyName>
    <RootNamespace>Guard.Linux</RootNamespace>
    <DebugType>embedded</DebugType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DefineConstants Condition=" '$(IsPortable)' == 'true' ">$(DefineConstants);PORTABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.3.0" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.5.1" />
    <PackageReference Include="Google.Protobuf" Version="3.35.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Guard.Core\Guard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Guard.Linux.SmokeTest" />
  </ItemGroup>

  <!-- Platform independent code shared with the Windows app -->
  <ItemGroup>
    <Compile Include="..\Guard.WPF\Core\Import\**\*.cs" Link="Shared\Import\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="..\Guard.WPF\Core\Import\ScreenCapture.cs" />
    <Compile Remove="..\Guard.WPF\Core\Import\Importer\ClipboardImporter.cs" />
    <Compile Remove="..\Guard.WPF\Core\Import\Importer\QRScreenCaptureImporter.cs" />
    <Compile Include="..\Guard.WPF\Core\Export\**\*.cs" Link="Shared\Export\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Guard.WPF\Core\Models\*.cs" Link="Shared\Models\%(Filename)%(Extension)" />
    <Compile Include="..\Guard.WPF\Core\Icons\IconManager.cs" Link="Shared\Icons\IconManager.cs" />
    <Compile Include="..\Guard.WPF\Core\Icons\SimpleIconsManager.cs" Link="Shared\Icons\SimpleIconsManager.cs" />
    <Compile Include="..\Guard.WPF\Core\Security\PasswordComplexity.cs" Link="Shared\Security\PasswordComplexity.cs" />
    <Compile Include="..\Guard.WPF\Core\TokenManager.cs" Link="Shared\TokenManager.cs" />
    <Compile Include="..\Guard.WPF\Core\NavigationContextManager.cs" Link="Shared\NavigationContextManager.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Guard.WPF\Assets\Icons\si.json" LogicalName="Guard.WPF.Assets.Icons.si.json" Link="Assets\Icons\si.json" />
    <EmbeddedResource Include="..\Guard.WPF\Resources\Strings.*.xaml" LogicalName="Strings.%(Filename)%(Extension)" WithCulture="false" Link="Resources\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\Guard.WPF\Assets\*.svg;..\Guard.WPF\Assets\*.png" Link="Assets\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
